 #!/usr/bin/env bash

FPS=144

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <path_to_image>"
  exit 1
fi

IMAGE="$1"

notify-send "Changing Theme"

swww img "$IMAGE" --transition-type="center" --transition-step=1 --transition-fps="$FPS"

# generate pywal colors
wal -i "$IMAGE" -n -s -t -e

# Make nvim use pywal colors
#TODO

matugen image "$IMAGE"
pkill waybar
waybar > /dev/null 2>&1 &

pkill swaync
swaync > /dev/null 2>&1 &

notify-send "Theme applied"
